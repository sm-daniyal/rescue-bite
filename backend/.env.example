# Copy this to .env and fill in real values
# Never commit .env to git

DATABASE_URL=sqlite+aiosqlite:///./rescuebite_dev.db
GEMINI_API_KEY=your_gemini_api_key_here

# Keep as "development" for competition/judge walkthroughs so /demo triggers
# and automatic startup table initialization stay active.
# Set to "production" for live merchant operations to lock down /demo endpoints.
ENVIRONMENT=development

# For production PostgreSQL (Supabase — requires adding asyncpg to requirements.txt):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
